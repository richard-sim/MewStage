+    /// <summary>
+    /// MewStage vendor patch text/0001: draws a letter-spaced text run one grapheme at a time, each at the column the layout
+    /// gave it (font advance, kerning and the spacing). Paint spans colour per grapheme; decorations span the run.
+    /// A grapheme's run box is at least its own advance: a negative kerning pair narrows the column, but kerning
+    /// moves the next grapheme, not this one's ink, and a backend that rasterizes a run into its box (plus the ink
+    /// overhang it measures from the glyphs' own advances) would otherwise cut the glyph at the kerned column.
+    /// </summary>
+    private void DrawLetterSpacedRun(
+        ManagedTextLayout managed,
+        ManagedTextLine line,
+        int runIndex,
+        in ManagedTextRun run,
+        Point origin,
+        Rect runBounds,
+        in TextDrawOptions options)
+    {
+        var spans = options.PaintSpans.Span;
+        int[] boundaries = managed.GetRunBoundaries(runIndex);
+        double spacing = managed.Snapshot.Paragraph.LetterSpacing;
+        for (int index = 0; index < boundaries.Length; index++)
+        {
+            int start = boundaries[index];
+            int end = index + 1 < boundaries.Length ? boundaries[index + 1] : run.TextEnd;
+            if (end <= start)
+            {
+                continue;
+            }
+
+            double left = managed.GetColumnX(in run, start);
+            double width = Math.Max(1, managed.GetColumnX(in run, end) - left - spacing);
+            Rect bounds = GetBaselineAlignedBounds(line, origin, left, width, run.Baseline, run.BaselineOffset, run.MeasuredHeight);
+            var realized = GetOrCreateRun(managed, start, end - start, run.Font, width, bounds.Height, options.Transient,
+                atLeastOwnAdvance: true);
+            if (realized is null)
+            {
+                continue;
+            }
+
+            try
+            {
+                Color color = GetSpanForeground(spans, start) ?? options.Foreground;
+                DrawRun(realized, bounds.Position, color, EffectiveOwner(in options));
+            }
+            finally
+            {
+                if (options.Transient)
+                {
+                    realized.Dispose();
+                }
+            }
+        }
+
+        DrawRunDecoration(
+            managed.Snapshot.GetStyle(run.TextStart),
+            origin.X + run.X,
+            origin.X + run.X + run.Width,
+            runBounds,
+            run.Baseline,
+            options.Foreground);
+    }
+
