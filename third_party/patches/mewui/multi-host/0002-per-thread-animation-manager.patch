+    // The manager this clock registered with (MewStage vendor patch multi-host/0002); the calling thread's until the first Start.
+    private AnimationManager? _manager;
+    private AnimationManager Manager => _manager ?? AnimationManager.Instance;
+
     /// <summary>
     /// Starts the animation from the beginning; a running clock restarts its timing.
     /// </summary>
@@ -136,7 +140,9 @@
