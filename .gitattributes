* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

*.dxil binary
*.spv binary
*.ttf binary
*.otf binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.7z binary
*.zip binary

# Vendored upstream trees keep their exact bytes: vendor.py --check compares them byte for byte with the pinned
# upstream archives, and some upstream files use CRLF.
third_party/MewUI/** -text
third_party/MewVG/** -text
