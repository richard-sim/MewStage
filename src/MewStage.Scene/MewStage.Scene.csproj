<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tier 2. The 3D content of the demo: the cube mesh, the grid floor, the cube scene renderer (one variant draws
    into a swapchain backbuffer, one into an offscreen viewport target) and the orbit camera. Knows nothing about
    MewUI: it only adds passes to a render graph.
  -->

  <PropertyGroup>
    <RootNamespace>MewStage.Scene</RootNamespace>
    <AssemblyName>MewStage.Scene</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MewStage.Demo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MewStage.Graphics\MewStage.Graphics.csproj" />
    <ProjectReference Include="..\MewStage.Rendering\MewStage.Rendering.csproj" />
  </ItemGroup>

</Project>
