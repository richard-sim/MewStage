<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tier 3. The windowed application stack: an SDL3 window on the app's GPU device with its swapchain, scheduler and
    render graph (GpuWindow), the UI layer that owns the embedded host, its input bridge and the gamepad navigator
    (UiLayer), the frame loop (AppHost), secondary OS windows on the same device, the SDL key map, the gamepad
    capture, the asset root lookup and the cooked-shader loader.
  -->

  <PropertyGroup>
    <RootNamespace>MewStage.Host</RootNamespace>
    <AssemblyName>MewStage.Host</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MewStage.Host.Tests" />
    <InternalsVisibleTo Include="MewStage.Demo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MewStage.Graphics\MewStage.Graphics.csproj" />
    <ProjectReference Include="..\MewStage.Rendering\MewStage.Rendering.csproj" />
    <ProjectReference Include="..\MewStage.Input\MewStage.Input.csproj" />
    <ProjectReference Include="..\MewStage.Ui.Navigation\MewStage.Ui.Navigation.csproj" />
    <ProjectReference Include="..\MewStage.Ui.Backend\MewStage.Ui.Backend.csproj" />
    <ProjectReference Include="..\..\third_party\MewUI\src\MewUI\MewUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.520.0" />
  </ItemGroup>

</Project>
